# CMake build trees. Covers the conventional `build/`, the sanitizer and
# cross-compile trees this project's README and CI use (build-san,
# build-aarch64), and CLion's default cmake-build-* directories.
build/
build-*/
cmake-build-*/

# CMake artifacts if someone configures in-source. Deliberately NOT a
# blanket "*.cmake" rule — that would also hide tracked toolchain files
# under cmake/ (e.g. cmake/aarch64-linux-gnu.cmake).
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json

# Output files produced by running the harness (see main.cpp).
sample_plaintext.bin
sample_ciphertext.aesc
sample.key

# Claude Code session state (permissions, task locks) — local tooling, not
# part of the project.
.claude/

# Python bytecode cache (bindings/python/, run manually or via the
# aeslib.capi_python CTest test).
__pycache__/
*.pyc

# Editors and IDEs
.idea/
.vscode/
*.swp
*~

# LaTeX build artifacts
*.aux
*.log
*.synctex.gz
*.out
*.toc
*.nav
*.snm
*.vrb
Challenge.pdf

# Confidential challenge brief — kept locally, never tracked.
Challenge.tex

# macOS / Windows filesystem noise
.DS_Store
Thumbs.db
